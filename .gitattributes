# Set default behavior to automatically normalize line endings
* text=auto

# Windows scripts must always have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Linux/Unix shell scripts and documentation must always have LF line endings
*.sh text eol=lf
*.md text eol=lf